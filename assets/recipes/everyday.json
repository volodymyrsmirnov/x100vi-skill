{
  "$schema": "https://raw.githubusercontent.com/volodymyrsmirnov/x100vi-skill/main/src/x100vi/recipe.schema.json",
  "source": "x100vi-skill starter recipe (original; not an emulation of any film stock)",
  "name": "EVERYDAY",
  "description": "Neutral, true-to-life colour that suits anything. A safe default to keep in C1.",
  "tags": [
    "neutral",
    "everyday",
    "natural",
    "default"
  ],
  "notes": "No exposure compensation needed.",
  "film_simulation": "reala_ace",
  "dynamic_range": "auto",
  "white_balance": {
    "mode": "auto",
    "shift_r": 0,
    "shift_b": 0
  },
  "highlight": -0.5,
  "shadow": -0.5,
  "color": 0,
  "sharpness": 0,
  "noise_reduction": -2
}
